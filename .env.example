# Copie para .env.local (desenvolvimento) ou cadastre na Vercel (Settings → Environment Variables).

# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-ou-publishable

# Opcional, mas recomendado para chamadas estáveis em qualquer rede (servidor TURN).
# Separe várias URLs por vírgula. Ex.: turn:turn.exemplo.com:3478,turns:turn.exemplo.com:5349
VITE_TURN_URLS=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# ---- Prisma (só no servidor: cadastre na Vercel SEM o prefixo VITE_) ----
GROQ_API_KEY=
SUPABASE_SERVICE_ROLE_KEY=
PRISMA_DAILY_LIMIT=40
# opcional: voz neural da Microsoft
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
PRISMA_VOICE=pt-BR-ThalitaMultilingualNeural

# ---- GIFs (só no servidor). Use UMA das duas:
# Tenor: console.cloud.google.com → APIs e serviços → ative "Tenor API" → Credenciais → Criar chave de API
TENOR_API_KEY=
# ou GIPHY: developers.giphy.com → Create an App → API
GIPHY_API_KEY=
