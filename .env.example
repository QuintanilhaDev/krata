# Copie para .env.local (desenvolvimento) ou cadastre na Vercel (Settings → Environment Variables).

# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-ou-publishable

# Opcional, mas recomendado para chamadas estáveis em qualquer rede (servidor TURN).
# Separe várias URLs por vírgula. Ex.: turn:turn.exemplo.com:3478,turns:turn.exemplo.com:5349
VITE_TURN_URLS=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
